      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"#", ",", "3"}], "]"}], "&"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParticleAssoc", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "->", 
