Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TorusDistance", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"v1_", ",", "v2_", ",", "v3_"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"w1_", ",", "w2_", ",", "w3_"}], "}"}]}], "}"}], ",", "L_"}], 
    "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalDelta]x", ",", "\[CapitalDelta]y", ",", "\[CapitalDelta]z"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalDelta]x", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"v1", "-", "w1"}], "]"}], ",", 
         RowBox[{"L", "-", 
          RowBox[{"Abs", "[", 
           RowBox[{"v1", "-", "w1"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]y", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"v2", "-", "w2"}], "]"}], ",", 
         RowBox[{"L", "-", 
          RowBox[{"Abs", "[", 
           RowBox[{"v2", "-", "w2"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]z", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"v3", "-", "w3"}], "]"}], ",", 
         RowBox[{"L", "-", 
          RowBox[{"Abs", "[", 
           RowBox[{"v3", "-", "w3"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"#", ".", "#"}]], "&"}], "@", 
       RowBox[{"{", 
        RowBox[{
        "\[CapitalDelta]x", ",", "\[CapitalDelta]y", ",", 
         "\[CapitalDelta]z"}], "}"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"for", " ", "distance", " ", "checks"}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"note", " ", "to", " ", "self"}], ",", " ", 
    RowBox[{
     RowBox[{"come", " ", "back", " ", "and", " ", "implement", " ", 
      SuperscriptBox["d", "2"]}], "-", 
     RowBox[{"checks", " ", "and", " ", "not", " ", "d"}], "-", "checks"}]}], 
   "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FindNeighbors", "[", "voxelcentre_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pairs", ",", 
       RowBox[{"\[CapitalDelta]l", "=", 
        RowBox[{"\[ScriptCapitalL]", "/", "num"}]}], ",", "neighborlist"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pairs", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"voxelcentre", ",", "#"}], "}"}], "&"}], "/@", 
        "VoxelCentres"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"neighborlist", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{"pairs", ",", 
         RowBox[{"n_", "/;", 
          RowBox[{
           RowBox[{"TorusDistance", "[", 
            RowBox[{"n", ",", "\[ScriptCapitalL]"}], "]"}], "<=", 
           RowBox[{
            SqrtBox["3"], "\[CapitalDelta]l"}]}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"neighborlist", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Code",
