Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LoopBack3", "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[DoubleStruckP]", ",", "correction"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[DoubleStruckP]", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"2", 
            RowBox[{
             RowBox[{"Abs", "[", "#", "]"}], "/", "\[ScriptCapitalL]"}]}], 
           "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "//", "Floor"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"correction", "=", 
        RowBox[{
         RowBox[{"-", "\[ScriptCapitalL]"}], " ", "\[DoubleStruckP]", " ", 
         RowBox[{"Sign", "[", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}]}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "implements", " ", "periodic", " ", "boundary", " ", "conditions", " ", 
    "on", " ", "a", " ", "single", " ", "particle"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LoopBack", "[", "state_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"working", ",", "parts", ",", "corrections"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"working", "=", 
        RowBox[{"Delete", "[", 
         RowBox[{"state", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"parts", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{"working", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"corrections", "=", 
        RowBox[{"LoopBack3", "/@", "parts"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"corrections", ",", "1"}], "]"}]}], "]"}], "+", 
        "state"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "implements", " ", "periodic", " ", "boundary", " ", "conditions", " ", 
    "on", " ", "all", " ", "particles"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TorusEulerUpdate", "[", "state_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalDelta]t", "=", ".25"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LoopBack", "[", 
       RowBox[{"state", "+", 
        RowBox[{"\[CapitalDelta]t", " ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "1", "}"}], ",", "\[DoubleStruckV]"}], "]"}]}]}], 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Euler", " ", "steps", " ", "the", " ", "state", " ", "subject", " ", "to",
     " ", "periodic", " ", "boundary", " ", "conditions"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TorusExtractTrajectories", "[", 
     RowBox[{"init_", ",", "steps_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"history", ",", "\[CapitalDelta]t"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"history", "=", 
        RowBox[{"NestList", "[", 
         RowBox[{"TorusEulerUpdate", ",", "init", ",", "steps"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"\[CapitalDelta]t", "=", 
        RowBox[{
         RowBox[{"history", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}], "//", 
         RowBox[{
          RowBox[{
           RowBox[{"Differences", "[", "#", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "&"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"history", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Delete", "[", 
           RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", "history"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"history", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Partition", "[", 
           RowBox[{"#", ",", "3"}], "]"}], "&"}], "/@", "history"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", 
           RowBox[{"(", 
            RowBox[{"Transpose", "@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Range", "[", "\[ScriptCapitalN]", "]"}], ",", 
               RowBox[{"history", "[", 
                RowBox[{"[", "t", "]"}], "]"}]}], "}"}]}], ")"}]}], "|>"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "1", ",", "steps", ",", "1"}], "}"}]}], "]"}]}]}],
      "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "extracts", " ", "particle", " ", "trajectories", " ", "coming", " ", 
    "from", " ", "an", " ", "initial", " ", "state", " ", "over", " ", "a", " ",
     "given", " ", "number", " ", "of", " ", "steps"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Transpose", "@", 
