     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cTb", "=", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"vc", ",", "vb"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"X", "=", 
       RowBox[{
        RowBox[{"Cases", "[", 
