      RowBox[{"Map", "[", 
       RowBox[{"Sort", ",", "#", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}], "&"}]}], "//", 
    "DeleteDuplicates"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeDistances", "[", 
    RowBox[{"pairs_", ",", "trajectories_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"TorusDistance", "[", 
      RowBox[{"#", ",", "\[ScriptCapitalL]"}], "]"}], "&"}], "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"trajectories", "/@", "#"}], ")"}], "&"}], "/@", "pairs"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ConstructSparseArray", "[", 
    RowBox[{"pairs_", ",", "distances_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "->", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"pairs", ",", 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{
            RowBox[{"-", "distances"}], "+", "2"}], "]"}]}], "}"}]}]}], "//", 
      
      RowBox[{
       RowBox[{"SparseArray", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"\[ScriptCapitalN]", ",", "\[ScriptCapitalN]"}], "}"}], ",",
          "\[Infinity]"}], "]"}], "&"}]}], "//", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", "#", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"0", "->", "\[Infinity]"}], "}"}]}], "&"}]}], "//", 
    "SparseArray"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SparseMin", "[", "ListOfArrays_", "]"}], ":=", 
  RowBox[{"SparseArray", "[", 
   RowBox[{"MapThread", "[", 
    RowBox[{"Min", ",", 
     RowBox[{"Normal", "/@", "ListOfArrays"}], ",", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ConstructCollisionArray", "[", "trajectory_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "voxeldirectory", ",", "ONtimeline", ",", "PairTimeline", ",", 
       "DistanceTimeline", ",", "SparseArrays", ",", "tWeights"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"voxeldirectory", "=", 
       RowBox[{"ExtractVoxelDirectory", "[", "trajectory", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ONtimeline", "=", 
       RowBox[{"IdentifyOccupiedNeighborhoods", "/@", "voxeldirectory"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"PairTimeline", "=", 
       RowBox[{"IdentifyPairs", "/@", "ONtimeline"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DistanceTimeline", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"ComputeDistances", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"Transpose", "@", 
          RowBox[{"{", 
           RowBox[{"PairTimeline", ",", "trajectory"}], "}"}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"SparseArrays", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"ConstructSparseArray", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"Transpose", "@", 
          RowBox[{"{", 
           RowBox[{"PairTimeline", ",", "DistanceTimeline"}], "}"}]}], 
         ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tWeights", "=", 
       RowBox[{".25", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "SparseArrays", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SparseMin", "[", 
        RowBox[{"tWeights", " ", "SparseArrays"}], "]"}], "//", 
       RowBox[{
        RowBox[{
         RowBox[{"Normal", "[", "#", "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"\[Infinity]", "->", "0."}], "}"}]}], "&"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
